# Machine-specific editor settings
/.vscode/
/.idea/

# Local environment files and private configuration overrides
.env
.env.*
!.env.example
!.env.sample
/config/*.local.php

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs, temporary files, and editor backups
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo
*~

# Downloaded local LaTeX compiler
/tools/latex/

# Lab reports, screenshots, and documentation stay local
/docs/

# LaTeX compilation intermediates
*.aux
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz
*.xdv
*.dvi

# Dependencies and generated submission archives
node_modules/
*.zip
*.7z
*.rar

# README documents stay on this computer, not in the repository
[Rr][Ee][Aa][Dd][Mm][Ee]*

# Keep application code, .htaccess files, the SQL seed, website images,
# tests, and administrator setup tools.
